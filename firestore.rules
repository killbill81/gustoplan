rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profil utilisateur
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Plans de repas et leur historique
    match /plans/{planId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.uid in resource.data.collaborators);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      
      match /history/{histId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && get(/databases/$(database)/documents/plans/$(planId)).data.userId == request.auth.uid;
      }
    }
    
    // Sauvegardes de plans
    match /plan_saves/{saveId} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Recettes (Lecture publique entre auth, écriture filtrée si on ajoute un champ ownerId plus tard, pour l'instant reste auth)
    match /recipes/{recipeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // On pourrait restreindre ici aussi si besoin
    }
    
    // Ingrédients et catégories
    match /ingredients/{id} {
      allow read, write: if request.auth != null;
    }
    match /ingredient_categories/{id} {
      allow read, write: if request.auth != null;
    }
    
    // Listes de courses
    match /shopping_lists/{listId} {
      allow read, write: if request.auth != null;
    }
    
    // Profils IA (Habitudes)
    match /ai_profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Partages, invitations et notifications
    match /shares/{id} {
      allow read, write: if request.auth != null;
    }
    match /friend_requests/{id} {
      allow read, write: if request.auth != null;
    }
    match /notifications/{id} {
      allow read, write: if request.auth != null;
    }
    
    // Par défaut : bloquer tout le reste
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
