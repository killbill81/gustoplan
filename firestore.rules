rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profil utilisateur
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Plans de repas et leur historique (Sécurisé)
    match /plans/{planId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Allow update if owner OR if user is authenticated (to allow addCollaborator)
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        request.auth.uid in resource.data.collaborators ||
        // Allow adding self to collaborators (or any update by auth user for beta)
        request.auth != null
      );
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      
      match /history/{histId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && get(/databases/$(database)/documents/plans/$(planId)).data.userId == request.auth.uid;
      }
    }
    
    // Sauvegardes de plans (Sécurisé)
    match /plan_saves/{saveId} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Recettes (Sécurisé : Lecture publique, Écriture privée ou Legacy)
    match /recipes/{recipeId} {
      allow read: if request.auth != null;
      // Création : OK si on signe avec son userId
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Modif/Suppression : Seulement le propriétaire OU si la recette n'a pas encore de propriétaire (Migration)
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || !('userId' in resource.data));
    }
    
    // Ingrédients (Sécurisé : Lecture publique, Écriture privée ou Legacy)
    match /ingredients/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || !('userId' in resource.data));
    }
    
    // Catégories (Lecture seule pour les utilisateurs, modif via Console Admin)
    match /ingredient_categories/{id} {
      allow read: if request.auth != null;
      allow write: if false; 
    }
    
    // Listes de courses (Sécurisé)
    match /shopping_lists/{listId} {
      // Si la liste contient un userId
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // FEEDBACK (Public Write, Auth Read for Admin)
    match /feedback/{id} {
      // Anyone can WRITE (Feedback)
      allow create: if true; 
      // Only Authenticated can READ (Ideally allow only specific Admin UID)
      allow read: if request.auth != null; 
    }
    
    // Profils IA (Habitudes)
    match /ai_profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Partages, invitations et notifications (Sécurisé sommairement pour l'instant)
    match /shares/{id} {
      allow read, write: if request.auth != null;
    }
    match /friend_requests/{id} {
        allow read, write: if request.auth != null;
    }
    match /notifications/{id} {
       allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Foyers et leurs sous-collections (V2)
    match /foyers/{foyerId} {
      allow read, write: if request.auth != null;
      
      match /recettes/{recetteId} {
        allow read, write: if request.auth != null;
      }
      match /planning/{planningId} {
        allow read, write: if request.auth != null;
      }
      match /liste_courses/{listeId} {
        allow read, write: if request.auth != null;
      }
      match /rayons_ingredients/{rayonId} {
        allow read, write: if request.auth != null;
      }
    }
    
    // Par défaut : bloquer tout le reste
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
